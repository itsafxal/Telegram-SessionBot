# ========================================================
# Universal Telegram MTProto Session Generator Config
# ========================================================

# Telegram Bot API Token obtained from @BotFather
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ123456789

# Telegram API ID and Hash obtained from https://my.telegram.org
API_ID=12345678
API_HASH=0123456789abcdef0123456789abcdef

# MongoDB Connection String (Atlas URI or local container instance)
# For production, use a dedicated application user with least-privilege (readWrite on bot DB):
# Example Atlas: mongodb+srv://session_app_user:YourStrongPassword@cluster.mongodb.net/telegram_session_bot?retryWrites=true&w=majority
# Example Docker compose internal network:
MONGODB_URI=mongodb://session_app_user:YourStrongPassword@mongo:27017/telegram_session_bot?authSource=telegram_session_bot

# MongoDB Database Name
MONGODB_DATABASE=telegram_session_bot

# Telegram numeric User ID of the bot owner (authorized for broadcasting)
OWNER_ID=123456789

# ========================================================
# Docker Compose MongoDB Credentials (Required for Docker compose)
# ========================================================
# Root admin credentials for MongoDB container initialization:
MONGO_ROOT_USERNAME=mongo_admin
MONGO_ROOT_PASSWORD=GenerateStrongRootPasswordHere

# Dedicated application credentials (created on fresh volumes with least-privilege):
# For existing volumes, run ./scripts/migrate-mongo-app-user.sh to provision the user safely.
MONGO_APP_USERNAME=session_app_user
MONGO_APP_PASSWORD=YourStrongPassword

# ========================================================
# Optional Configuration
# ========================================================

# Logging level: DEBUG, INFO, WARN, ERROR (default: INFO)
LOG_LEVEL=INFO

# Python binary path (default auto-detected: python3 or python)
# PYTHON_PATH=/usr/local/bin/python3

# Timeout in seconds for Python MTProto worker commands (default: 300)
# WORKER_TIMEOUT_SECONDS=300

# Concurrency limit for active authentication sessions (default: 50)
# MAX_CONCURRENT_AUTH=50

# Concurrency slot acquisition timeout in seconds (default: 5)
# SLOT_ACQUIRE_TIMEOUT_SECONDS=5

# Maximum phone number submission attempts per user session (default: 5)
# PHONE_MAX_ATTEMPTS=5
